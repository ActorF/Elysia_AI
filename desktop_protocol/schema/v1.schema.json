{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elysia.ai/schema/desktop-protocol/v1",
  "title": "Elysia Desktop Protocol v1",
  "x-elysia-frameMaxBytes": 16777216,
  "x-elysia-stringLengthUnit": "Unicode code points",
  "x-elysia-blankCodePoints": [
    "U+0009-U+000D", "U+0020", "U+0085", "U+00A0", "U+1680",
    "U+2000-U+200A", "U+2028-U+2029", "U+202F", "U+205F",
    "U+3000", "U+FEFF"
  ],
  "x-elysia-runtimeInvariants": [
    "progress.total is null or greater than or equal to progress.completed",
    "initializeResult.modelName is present in initializeResult.models",
    "chatStateResult.chats has unique chatId values",
    "chatStateResult.activeChat appears in chats with identical summary fields",
    "chatDetail.messages has unique messageId values and its length equals messageCount",
    "projectStateResult.projects has unique projectId values",
    "projectStateResult.activeProject is null or appears in projects with identical fields",
    "every non-null projectId in projectStateResult.chatState refers to projectStateResult.projects",
    "each Project chatCount equals all matching Chats in projectStateResult.chatState.chats",
    "settingsStateResult.restartRequired is true exactly when restartFields is non-empty",
    "stream sequences are contiguous per request and have exactly one terminal chunk",
    "the terminal response reply exactly equals the concatenated stream chunks",
    "request and permission identifiers correlate with live pending operations",
    "attachment.add sourcePaths are unique after Windows separator, dot-segment, and case normalization",
    "voice.capture.complete sampleCount and speech markers are aligned to 320-sample frames",
    "voice.capture.complete speech markers satisfy 0 <= speechStartSample < speechEndSample <= sampleCount and span at least 3200 samples",
    "voice.capture.complete pcmBase64 is strict canonical Base64 whose decoded byte length equals sampleCount * 2",
    "voice.capture results derive durationMs and speechDurationMs exactly from their sample metadata"
  ],
  "oneOf": [
    { "$ref": "#/$defs/handshakeRequest" },
    { "$ref": "#/$defs/initializeRequest" },
    { "$ref": "#/$defs/chatStreamRequest" },
    { "$ref": "#/$defs/chatRetryRequest" },
    { "$ref": "#/$defs/chatListRequest" },
    { "$ref": "#/$defs/chatCreateRequest" },
    { "$ref": "#/$defs/chatOpenRequest" },
    { "$ref": "#/$defs/chatRenameRequest" },
    { "$ref": "#/$defs/chatPinRequest" },
    { "$ref": "#/$defs/chatArchiveRequest" },
    { "$ref": "#/$defs/chatDeleteRequest" },
    { "$ref": "#/$defs/attachmentListRequest" },
    { "$ref": "#/$defs/attachmentAddRequest" },
    { "$ref": "#/$defs/attachmentRemoveRequest" },
    { "$ref": "#/$defs/projectListRequest" },
    { "$ref": "#/$defs/projectCreateRequest" },
    { "$ref": "#/$defs/projectOpenRequest" },
    { "$ref": "#/$defs/projectUpdateRequest" },
    { "$ref": "#/$defs/projectWorkspaceRequest" },
    { "$ref": "#/$defs/projectArchiveRequest" },
    { "$ref": "#/$defs/projectChatMoveRequest" },
    { "$ref": "#/$defs/settingsGetRequest" },
    { "$ref": "#/$defs/settingsUpdateRequest" },
    { "$ref": "#/$defs/voiceSettingsGetRequest" },
    { "$ref": "#/$defs/voiceSettingsUpdateRequest" },
    { "$ref": "#/$defs/voiceCaptureCompleteRequest" },
    { "$ref": "#/$defs/cancelRequest" },
    { "$ref": "#/$defs/permissionResponseRequest" },
    { "$ref": "#/$defs/shutdownRequest" },
    { "$ref": "#/$defs/successResponse" },
    { "$ref": "#/$defs/errorResponse" },
    { "$ref": "#/$defs/streamChunk" },
    { "$ref": "#/$defs/progress" },
    { "$ref": "#/$defs/permission" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "voiceSessionIdentifier": {
      "type": "string",
      "minLength": 7,
      "maxLength": 128,
      "pattern": "^voice_[A-Za-z0-9_-]+$"
    },
    "audioDeviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!(?:default|communications)$)[^\\u0000-\\u001F\\u007F-\\u009F]*$"
    },
    "nullableAudioDeviceId": {
      "oneOf": [
        { "$ref": "#/$defs/audioDeviceId" },
        { "type": "null" }
      ]
    },
    "projectIdentifier": {
      "type": "string",
      "minLength": 9,
      "maxLength": 128,
      "pattern": "^project_[A-Za-z0-9_-]+$"
    },
    "protocol": {
      "type": "object",
      "properties": {
        "name": { "const": "elysia.desktop" },
        "version": { "const": 1 }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "requestEnvelope": {
      "type": "object",
      "properties": {
        "type": { "const": "request" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "id": { "$ref": "#/$defs/identifier" },
        "method": {
          "enum": [
            "handshake",
            "initialize",
            "chat.stream",
            "chat.retry",
            "chat.list",
            "chat.create",
            "chat.open",
            "chat.rename",
            "chat.pin",
            "chat.archive",
            "chat.delete",
            "attachment.list",
            "attachment.add",
            "attachment.remove",
            "project.list",
            "project.create",
            "project.open",
            "project.update",
            "project.workspace",
            "project.archive",
            "project.chat.move",
            "settings.get",
            "settings.update",
            "voice.settings.get",
            "voice.settings.update",
            "voice.capture.complete",
            "request.cancel",
            "permission.respond",
            "shutdown"
          ]
        },
        "params": { "type": "object" }
      },
      "required": ["type", "protocol", "id", "method", "params"],
      "additionalProperties": false
    },
    "handshakeParams": {
      "type": "object",
      "properties": {
        "client": {
          "type": "object",
          "properties": {
            "name": { "$ref": "#/$defs/identifier" },
            "version": { "$ref": "#/$defs/identifier" }
          },
          "required": ["name", "version"],
          "additionalProperties": false
        },
        "sessionToken": {
          "type": "string",
          "minLength": 32,
          "maxLength": 512
        }
      },
      "required": ["client", "sessionToken"],
      "additionalProperties": false
    },
    "initializeParams": {
      "type": "object",
      "maxProperties": 0
    },
    "chatStreamParams": {
      "type": "object",
      "properties": {
        "chatId": { "$ref": "#/$defs/identifier" },
        "message": {
          "type": "string",
          "maxLength": 1000000
        },
        "attachmentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^attachment_[A-Za-z0-9_-]+$",
            "maxLength": 128
          },
          "maxItems": 10,
          "uniqueItems": true
        }
      },
      "required": ["chatId", "message"],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "message": {
              "minLength": 1,
              "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
            }
          }
        },
        {
          "properties": { "attachmentIds": { "minItems": 1 } },
          "required": ["attachmentIds"]
        }
      ]
    },
    "attachmentScope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "const": "chat" },
            "id": {
              "type": "string",
              "pattern": "^chat_[A-Za-z0-9_-]+$",
              "maxLength": 128
            }
          },
          "required": ["kind", "id"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "project" },
            "id": { "$ref": "#/$defs/projectIdentifier" }
          },
          "required": ["kind", "id"],
          "additionalProperties": false
        }
      ]
    },
    "attachmentListParams": {
      "type": "object",
      "properties": { "scope": { "$ref": "#/$defs/attachmentScope" } },
      "required": ["scope"],
      "additionalProperties": false
    },
    "attachmentAddParams": {
      "type": "object",
      "properties": {
        "scope": { "$ref": "#/$defs/attachmentScope" },
        "sourcePaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 32767,
            "pattern": "^(?!\\s)(?!.*[\\r\\n\\u0000])[A-Za-z]:[\\\\/](?!\\.{1,2}(?:[\\\\/]|$))(?!.*:)(?!.*[\\\\/]\\.{1,2}(?:[\\\\/]|$)).*\\S$"
          },
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true
        }
      },
      "required": ["scope", "sourcePaths"],
      "additionalProperties": false
    },
    "attachmentRemoveParams": {
      "type": "object",
      "properties": {
        "scope": { "$ref": "#/$defs/attachmentScope" },
        "attachmentId": {
          "type": "string",
          "pattern": "^attachment_[A-Za-z0-9_-]+$",
          "maxLength": 128
        }
      },
      "required": ["scope", "attachmentId"],
      "additionalProperties": false
    },
    "chatRetryParams": {
      "type": "object",
      "properties": {
        "chatId": { "$ref": "#/$defs/identifier" },
        "userMessageId": { "$ref": "#/$defs/identifier" },
        "assistantMessageId": { "$ref": "#/$defs/identifier" },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000,
          "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
        }
      },
      "required": ["chatId", "userMessageId", "assistantMessageId"],
      "additionalProperties": false
    },
    "chatListParams": {
      "type": "object",
      "properties": {
        "includeArchived": { "type": "boolean" }
      },
      "required": ["includeArchived"],
      "additionalProperties": false
    },
    "conversationMode": {
      "enum": ["chat", "work"]
    },
    "chatTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000000,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
    },
    "chatCreateParams": {
      "type": "object",
      "properties": {
        "title": { "$ref": "#/$defs/chatTitle" },
        "mode": { "$ref": "#/$defs/conversationMode" }
      },
      "required": ["title", "mode"],
      "additionalProperties": false
    },
    "chatIdParams": {
      "type": "object",
      "properties": {
        "chatId": { "$ref": "#/$defs/identifier" }
      },
      "required": ["chatId"],
      "additionalProperties": false
    },
    "chatRenameParams": {
      "type": "object",
      "properties": {
        "chatId": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/chatTitle" }
      },
      "required": ["chatId", "title"],
      "additionalProperties": false
    },
    "chatPinParams": {
      "type": "object",
      "properties": {
        "chatId": { "$ref": "#/$defs/identifier" },
        "pinned": { "type": "boolean" }
      },
      "required": ["chatId", "pinned"],
      "additionalProperties": false
    },
    "chatArchiveParams": {
      "type": "object",
      "properties": {
        "chatId": { "$ref": "#/$defs/identifier" },
        "archived": { "type": "boolean" }
      },
      "required": ["chatId", "archived"],
      "additionalProperties": false
    },
    "projectName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
    },
    "nullableProjectInstructions": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000,
          "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
        },
        { "type": "null" }
      ]
    },
    "nullableWorkspacePath": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 32767,
          "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
        },
        { "type": "null" }
      ]
    },
    "projectListParams": {
      "type": "object",
      "maxProperties": 0
    },
    "projectCreateParams": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/projectName" },
        "customInstructions": { "$ref": "#/$defs/nullableProjectInstructions" }
      },
      "required": ["name", "customInstructions"],
      "additionalProperties": false
    },
    "projectIdParams": {
      "type": "object",
      "properties": {
        "projectId": { "$ref": "#/$defs/projectIdentifier" }
      },
      "required": ["projectId"],
      "additionalProperties": false
    },
    "projectUpdateParams": {
      "type": "object",
      "properties": {
        "projectId": { "$ref": "#/$defs/projectIdentifier" },
        "name": { "$ref": "#/$defs/projectName" },
        "customInstructions": { "$ref": "#/$defs/nullableProjectInstructions" }
      },
      "required": ["projectId", "name", "customInstructions"],
      "additionalProperties": false
    },
    "projectWorkspaceParams": {
      "type": "object",
      "properties": {
        "projectId": { "$ref": "#/$defs/projectIdentifier" },
        "workspacePath": { "$ref": "#/$defs/nullableWorkspacePath" }
      },
      "required": ["projectId", "workspacePath"],
      "additionalProperties": false
    },
    "projectArchiveParams": {
      "type": "object",
      "properties": {
        "projectId": { "$ref": "#/$defs/projectIdentifier" },
        "archived": { "type": "boolean" }
      },
      "required": ["projectId", "archived"],
      "additionalProperties": false
    },
    "projectChatMoveParams": {
      "type": "object",
      "properties": {
        "chatId": { "$ref": "#/$defs/identifier" },
        "projectId": {
          "oneOf": [
            { "$ref": "#/$defs/projectIdentifier" },
            { "type": "null" }
          ]
        }
      },
      "required": ["chatId", "projectId"],
      "additionalProperties": false
    },
    "settingsValues": {
      "type": "object",
      "properties": {
        "modelName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "allOf": [
            {
              "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
            },
            { "pattern": "^[^\\u0000\\r\\n]*$" }
          ]
        },
        "ollamaHost": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https?://(?![^/?#@\\s]*:0(?:/|$))[^/?#@\\s]+/?$"
        },
        "shortTermMemoryTokenBudget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "memoryRetrievalLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "dataImportMaxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "modelName",
        "ollamaHost",
        "shortTermMemoryTokenBudget",
        "memoryRetrievalLimit",
        "dataImportMaxBytes"
      ],
      "additionalProperties": false
    },
    "settingsGetParams": {
      "type": "object",
      "maxProperties": 0
    },
    "settingsUpdateParams": {
      "type": "object",
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "settings": { "$ref": "#/$defs/settingsValues" }
      },
      "required": ["expectedRevision", "settings"],
      "additionalProperties": false
    },
    "voiceSettingsGetParams": {
      "type": "object",
      "maxProperties": 0
    },
    "voiceSettingsUpdateParams": {
      "type": "object",
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inputDeviceId": { "$ref": "#/$defs/nullableAudioDeviceId" },
        "outputDeviceId": { "$ref": "#/$defs/nullableAudioDeviceId" }
      },
      "required": [
        "expectedRevision", "inputDeviceId", "outputDeviceId"
      ],
      "additionalProperties": false
    },
    "voiceCaptureCompleteParams": {
      "type": "object",
      "properties": {
        "sessionId": { "$ref": "#/$defs/voiceSessionIdentifier" },
        "chatId": { "$ref": "#/$defs/identifier" },
        "sampleRateHz": { "const": 16000 },
        "channelCount": { "const": 1 },
        "sampleFormat": { "const": "s16le" },
        "sampleCount": {
          "type": "integer",
          "minimum": 3200,
          "maximum": 480000,
          "multipleOf": 320
        },
        "speechStartSample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 480000,
          "multipleOf": 320
        },
        "speechEndSample": {
          "type": "integer",
          "minimum": 3200,
          "maximum": 480000,
          "multipleOf": 320
        },
        "pcmBase64": {
          "type": "string",
          "minLength": 8536,
          "maxLength": 1280000,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "contentEncoding": "base64"
        }
      },
      "required": [
        "sessionId", "chatId", "sampleRateHz", "channelCount",
        "sampleFormat", "sampleCount", "speechStartSample",
        "speechEndSample", "pcmBase64"
      ],
      "additionalProperties": false
    },
    "cancelParams": {
      "type": "object",
      "properties": {
        "requestId": { "$ref": "#/$defs/identifier" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "required": ["requestId"],
      "additionalProperties": false
    },
    "permissionResponseParams": {
      "type": "object",
      "properties": {
        "permissionId": { "$ref": "#/$defs/identifier" },
        "granted": { "type": "boolean" }
      },
      "required": ["permissionId", "granted"],
      "additionalProperties": false
    },
    "shutdownParams": {
      "type": "object",
      "maxProperties": 0
    },
    "handshakeRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "handshake" },
            "params": { "$ref": "#/$defs/handshakeParams" }
          }
        }
      ]
    },
    "initializeRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "initialize" },
            "params": { "$ref": "#/$defs/initializeParams" }
          }
        }
      ]
    },
    "chatStreamRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "chat.stream" },
            "params": { "$ref": "#/$defs/chatStreamParams" }
          }
        }
      ]
    },
    "chatRetryRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "chat.retry" },
            "params": { "$ref": "#/$defs/chatRetryParams" }
          }
        }
      ]
    },
    "chatListRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "chat.list" },
            "params": { "$ref": "#/$defs/chatListParams" }
          }
        }
      ]
    },
    "chatCreateRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "chat.create" },
            "params": { "$ref": "#/$defs/chatCreateParams" }
          }
        }
      ]
    },
    "chatOpenRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "chat.open" },
            "params": { "$ref": "#/$defs/chatIdParams" }
          }
        }
      ]
    },
    "chatRenameRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "chat.rename" },
            "params": { "$ref": "#/$defs/chatRenameParams" }
          }
        }
      ]
    },
    "chatPinRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "chat.pin" },
            "params": { "$ref": "#/$defs/chatPinParams" }
          }
        }
      ]
    },
    "chatArchiveRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "chat.archive" },
            "params": { "$ref": "#/$defs/chatArchiveParams" }
          }
        }
      ]
    },
    "chatDeleteRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "chat.delete" },
            "params": { "$ref": "#/$defs/chatIdParams" }
          }
        }
      ]
    },
    "attachmentListRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "attachment.list" },
            "params": { "$ref": "#/$defs/attachmentListParams" }
          }
        }
      ]
    },
    "attachmentAddRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "attachment.add" },
            "params": { "$ref": "#/$defs/attachmentAddParams" }
          }
        }
      ]
    },
    "attachmentRemoveRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "attachment.remove" },
            "params": { "$ref": "#/$defs/attachmentRemoveParams" }
          }
        }
      ]
    },
    "projectListRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "project.list" },
            "params": { "$ref": "#/$defs/projectListParams" }
          }
        }
      ]
    },
    "projectCreateRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "project.create" },
            "params": { "$ref": "#/$defs/projectCreateParams" }
          }
        }
      ]
    },
    "projectOpenRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "project.open" },
            "params": { "$ref": "#/$defs/projectIdParams" }
          }
        }
      ]
    },
    "projectUpdateRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "project.update" },
            "params": { "$ref": "#/$defs/projectUpdateParams" }
          }
