    "error": {
      "type": "object",
      "properties": {
        "code": { "$ref": "#/$defs/identifier" },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "retryable": { "type": "boolean" }
      },
      "required": ["code", "message", "retryable"],
      "additionalProperties": false
    },
    "handshakeResult": {
      "type": "object",
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "server": {
          "type": "object",
          "properties": {
            "name": { "$ref": "#/$defs/identifier" },
            "version": { "$ref": "#/$defs/identifier" }
          },
          "required": ["name", "version"],
          "additionalProperties": false
        },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["protocol", "server", "capabilities"],
      "additionalProperties": false
    },
    "initializeResult": {
      "type": "object",
      "properties": {
        "modelName": { "$ref": "#/$defs/identifier" },
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "minItems": 1,
          "uniqueItems": true
        },
        "chatId": { "$ref": "#/$defs/identifier" },
        "chatTitle": { "type": "string", "minLength": 1, "maxLength": 1000000 }
      },
      "required": ["modelName", "models", "chatId", "chatTitle"],
      "additionalProperties": false
    },
    "chatResult": {
      "type": "object",
      "properties": {
        "chatId": { "$ref": "#/$defs/identifier" },
        "reply": { "type": "string", "minLength": 1, "maxLength": 1000000 }
      },
      "required": ["chatId", "reply"],
      "additionalProperties": false
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "nullableIdentifier": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "attachmentFileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))(?!\\.{1,2}$)(?!\\s)(?!.*[<>:\"/\\\\|?*\\u0000-\\u001F\\u007F\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069])(?!.*\\.$).*\\S$"
    },
    "attachmentMediaType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+\\-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+\\-]*$"
    },
    "chatAttachment": {
      "type": "object",
      "properties": {
        "attachmentId": {
          "type": "string",
          "pattern": "^attachment_[A-Za-z0-9_-]+$",
          "maxLength": 128
        },
        "fileName": { "$ref": "#/$defs/attachmentFileName" },
        "mediaType": { "$ref": "#/$defs/attachmentMediaType" },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": ["attachmentId", "fileName", "mediaType", "sizeBytes"],
      "additionalProperties": false
    },
    "attachmentItem": {
      "type": "object",
      "properties": {
        "attachmentId": {
          "type": "string",
          "pattern": "^attachment_[A-Za-z0-9_-]+$",
          "maxLength": 128
        },
        "fileName": { "$ref": "#/$defs/attachmentFileName" },
        "mediaType": { "$ref": "#/$defs/attachmentMediaType" },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": { "const": "ready" }
      },
      "required": ["attachmentId", "fileName", "mediaType", "sizeBytes", "status"],
      "additionalProperties": false
    },
    "attachmentStateResult": {
      "type": "object",
      "properties": {
        "scope": { "$ref": "#/$defs/attachmentScope" },
        "attachments": {
          "type": "array",
          "items": { "$ref": "#/$defs/attachmentItem" },
          "maxItems": 10
        },
        "maxFileBytes": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "maxFileCount": { "type": "integer", "minimum": 1, "maximum": 10 }
      },
      "required": ["scope", "attachments", "maxFileBytes", "maxFileCount"],
      "additionalProperties": false
    },
    "chatSessionMessage": {
      "type": "object",
      "properties": {
        "messageId": { "$ref": "#/$defs/identifier" },
        "role": { "enum": ["system", "user", "assistant"] },
        "content": { "type": "string", "maxLength": 1000000 },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "attachments": {
          "type": "array",
          "items": { "$ref": "#/$defs/chatAttachment" },
          "maxItems": 10,
          "uniqueItems": true
        }
      },
      "required": ["messageId", "role", "content", "createdAt", "attachments"],
      "additionalProperties": false
    },
    "chatSummaryShape": {
      "type": "object",
      "properties": {
        "chatId": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 1000000 },
        "mode": { "$ref": "#/$defs/conversationMode" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" },
        "messageCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "projectId": { "$ref": "#/$defs/nullableIdentifier" },
        "modelName": { "$ref": "#/$defs/identifier" },
        "pinned": { "type": "boolean" },
        "archived": { "type": "boolean" }
      },
      "required": [
        "chatId", "title", "mode", "createdAt", "updatedAt",
        "messageCount", "projectId", "modelName", "pinned", "archived"
      ]
    },
    "chatSessionSummary": {
      "allOf": [
        { "$ref": "#/$defs/chatSummaryShape" }
      ],
      "unevaluatedProperties": false
    },
    "chatDetail": {
      "allOf": [
        { "$ref": "#/$defs/chatSummaryShape" },
        {
          "type": "object",
          "properties": {
            "messages": {
              "type": "array",
              "items": { "$ref": "#/$defs/chatSessionMessage" },
              "uniqueItems": true
            }
          },
          "required": ["messages"]
        }
      ],
      "unevaluatedProperties": false
    },
    "chatStateResult": {
      "type": "object",
      "properties": {
        "activeChat": { "$ref": "#/$defs/chatDetail" },
        "chats": {
          "type": "array",
          "items": { "$ref": "#/$defs/chatSessionSummary" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["activeChat", "chats"],
      "additionalProperties": false
    },
    "projectSummary": {
      "type": "object",
      "properties": {
        "projectId": { "$ref": "#/$defs/projectIdentifier" },
        "name": { "$ref": "#/$defs/projectName" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" },
        "customInstructions": { "$ref": "#/$defs/nullableProjectInstructions" },
        "workspacePath": { "$ref": "#/$defs/nullableWorkspacePath" },
        "archived": { "type": "boolean" },
        "chatCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "projectId", "name", "createdAt", "updatedAt",
        "customInstructions", "workspacePath", "archived", "chatCount"
      ],
      "additionalProperties": false
    },
