          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": ["chatId", "chatTitle", "modelName"],
      "additionalProperties": false
    },
    "settingsScopes": {
      "type": "object",
      "properties": {
        "project": {
          "oneOf": [
            { "$ref": "#/$defs/settingsProjectScope" },
            { "type": "null" }
