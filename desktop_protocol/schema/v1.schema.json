          "type": "array",
          "items": { "$ref": "#/$defs/projectSummary" },
          "uniqueItems": true
        },
        "chatState": { "$ref": "#/$defs/chatStateResult" }
      },
      "required": ["activeProject", "projects", "chatState"],
      "additionalProperties": false
    },
    "settingsProjectScope": {
      "type": "object",
      "properties": {
        "projectId": { "$ref": "#/$defs/projectIdentifier" },
        "projectName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "modelName": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 200 },
            { "type": "null" }
          ]
        },
