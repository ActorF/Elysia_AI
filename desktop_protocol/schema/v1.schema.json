          "oneOf": [
            { "$ref": "#/$defs/settingsChatScope" },
            { "type": "null" }
          ]
        }
      },
      "required": ["project", "chat"],
      "additionalProperties": false
    },
    "settingsStateResult": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updatedAt": {
          "oneOf": [
            { "$ref": "#/$defs/timestamp" },
            { "type": "null" }
          ]
        },
        "settings": { "$ref": "#/$defs/settingsValues" },
        "activeSettings": { "$ref": "#/$defs/settingsValues" },
        "restartRequired": { "type": "boolean" },
        "restartFields": {
          "type": "array",
          "items": {
            "enum": [
              "modelName",
              "ollamaHost",
              "shortTermMemoryTokenBudget",
              "memoryRetrievalLimit",
              "dataImportMaxBytes"
            ]
          },
          "maxItems": 5,
          "uniqueItems": true
        },
        "scopes": { "$ref": "#/$defs/settingsScopes" },
        "warning": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 1000 },
            { "type": "null" }
          ]
        }
      },
      "required": [
        "revision",
        "updatedAt",
        "settings",
        "activeSettings",
        "restartRequired",
        "restartFields",
        "scopes",
        "warning"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "restartRequired": { "const": true } },
            "required": ["restartRequired"]
          },
          "then": {
            "properties": { "restartFields": { "minItems": 1 } }
          },
          "else": {
            "properties": { "restartFields": { "maxItems": 0 } }
          }
        }
      ]
    },
    "voiceSettingsStateResult": {
      "type": "object",
      "properties": {
        "kind": { "const": "voice.settings" },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updatedAt": {
          "oneOf": [
            { "$ref": "#/$defs/timestamp" },
            { "type": "null" }
          ]
        },
        "inputDeviceId": { "$ref": "#/$defs/nullableAudioDeviceId" },
        "outputDeviceId": { "$ref": "#/$defs/nullableAudioDeviceId" },
        "warning": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 1000 },
            { "type": "null" }
          ]
        }
      },
      "required": [
        "kind", "revision", "updatedAt", "inputDeviceId",
        "outputDeviceId", "warning"
      ],
      "additionalProperties": false
    },
    "voiceCaptureResult": {
      "type": "object",
      "properties": {
        "kind": { "const": "voice.capture" },
        "sessionId": { "$ref": "#/$defs/voiceSessionIdentifier" },
        "chatId": { "$ref": "#/$defs/identifier" },
        "sampleRateHz": { "const": 16000 },
        "channelCount": { "const": 1 },
        "sampleFormat": { "const": "s16le" },
        "sampleCount": {
          "type": "integer",
          "minimum": 3200,
          "maximum": 480000,
          "multipleOf": 320
        },
        "speechStartSample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 480000,
          "multipleOf": 320
        },
        "speechEndSample": {
          "type": "integer",
          "minimum": 3200,
          "maximum": 480000,
          "multipleOf": 320
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "speechDurationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "sha256Hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind", "sessionId", "chatId", "sampleRateHz", "channelCount",
        "sampleFormat", "sampleCount", "speechStartSample",
        "speechEndSample", "durationMs", "speechDurationMs", "sha256Hex"
      ],
      "additionalProperties": false
    },
    "shutdownResult": {
      "type": "object",
      "properties": { "stopped": { "const": true } },
      "required": ["stopped"],
      "additionalProperties": false
    },
    "successResponse": {
      "type": "object",
      "properties": {
        "type": { "const": "response" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "id": { "$ref": "#/$defs/identifier" },
        "ok": { "const": true },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/handshakeResult" },
            { "$ref": "#/$defs/initializeResult" },
            { "$ref": "#/$defs/chatResult" },
            { "$ref": "#/$defs/chatStateResult" },
            { "$ref": "#/$defs/projectStateResult" },
            { "$ref": "#/$defs/attachmentStateResult" },
            { "$ref": "#/$defs/settingsStateResult" },
            { "$ref": "#/$defs/voiceSettingsStateResult" },
            { "$ref": "#/$defs/voiceCaptureResult" },
            { "$ref": "#/$defs/shutdownResult" }
          ]
        }
      },
      "required": ["type", "protocol", "id", "ok", "result"],
      "additionalProperties": false
    },
    "errorResponse": {
      "type": "object",
      "properties": {
        "type": { "const": "response" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "id": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "ok": { "const": false },
        "error": { "$ref": "#/$defs/error" }
      },
      "required": ["type", "protocol", "id", "ok", "error"],
      "additionalProperties": false
    },
    "streamChunk": {
      "type": "object",
      "properties": {
        "type": { "const": "stream" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "requestId": { "$ref": "#/$defs/identifier" },
        "stream": { "const": "chat.reply" },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "chunk": { "type": "string", "maxLength": 1000000 },
        "done": { "type": "boolean" }
      },
      "required": [
        "type", "protocol", "requestId", "stream", "sequence", "chunk", "done"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "done": { "const": true } },
            "required": ["done"]
          },
          "then": {
            "properties": { "chunk": { "const": "" } }
          }
        }
      ]
    },
    "progress": {
      "type": "object",
      "properties": {
        "type": { "const": "progress" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "requestId": { "$ref": "#/$defs/identifier" },
        "operation": { "$ref": "#/$defs/identifier" },
        "completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            { "type": "null" }
          ]
        },
        "message": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 1000000 },
            { "type": "null" }
          ]
        }
      },
      "required": [
        "type", "protocol", "requestId", "operation", "completed", "total", "message"
      ],
      "additionalProperties": false
    },
    "permission": {
      "type": "object",
      "properties": {
        "type": { "const": "permission" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "requestId": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "permissionId": { "$ref": "#/$defs/identifier" },
        "capability": { "$ref": "#/$defs/identifier" },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "scopes": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      },
      "required": [
        "type", "protocol", "requestId", "permissionId", "capability", "reason", "scopes"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "type": { "const": "event" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "event": { "$ref": "#/$defs/identifier" },
        "requestId": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "data": { "type": "object" }
      },
      "required": ["type", "protocol", "event", "requestId", "data"],
      "additionalProperties": false
    }
  }
}
