{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elysia.ai/schema/desktop-protocol/v1",
  "title": "Elysia Desktop Protocol v1",
  "x-elysia-frameMaxBytes": 16777216,
  "x-elysia-stringLengthUnit": "Unicode code points",
  "x-elysia-blankCodePoints": [
    "U+0009-U+000D", "U+0020", "U+0085", "U+00A0", "U+1680",
    "U+2000-U+200A", "U+2028-U+2029", "U+202F", "U+205F",
    "U+3000", "U+FEFF"
  ],
  "x-elysia-runtimeInvariants": [
    "progress.total is null or greater than or equal to progress.completed",
    "initializeResult.modelName is present in initializeResult.models",
    "chatStateResult.chats has unique chatId values",
    "chatStateResult.activeChat appears in chats with identical summary fields",
    "chatDetail.messages has unique messageId values and its length equals messageCount",
    "projectStateResult.projects has unique projectId values",
    "projectStateResult.activeProject is null or appears in projects with identical fields",
    "every non-null projectId in projectStateResult.chatState refers to projectStateResult.projects",
    "each Project chatCount equals all matching Chats in projectStateResult.chatState.chats",
    "settingsStateResult.restartRequired is true exactly when restartFields is non-empty",
    "stream sequences are contiguous per request and have exactly one terminal chunk",
    "the terminal response reply exactly equals the concatenated stream chunks",
    "request and permission identifiers correlate with live pending operations"
  ],
  "oneOf": [
    { "$ref": "#/$defs/handshakeRequest" },
    { "$ref": "#/$defs/initializeRequest" },
    { "$ref": "#/$defs/chatStreamRequest" },
    { "$ref": "#/$defs/chatRetryRequest" },
    { "$ref": "#/$defs/chatListRequest" },
    { "$ref": "#/$defs/chatCreateRequest" },
    { "$ref": "#/$defs/chatOpenRequest" },
    { "$ref": "#/$defs/chatRenameRequest" },
    { "$ref": "#/$defs/chatPinRequest" },
    { "$ref": "#/$defs/chatArchiveRequest" },
    { "$ref": "#/$defs/chatDeleteRequest" },
    { "$ref": "#/$defs/projectListRequest" },
    { "$ref": "#/$defs/projectCreateRequest" },
    { "$ref": "#/$defs/projectOpenRequest" },
    { "$ref": "#/$defs/projectUpdateRequest" },
    { "$ref": "#/$defs/projectWorkspaceRequest" },
    { "$ref": "#/$defs/projectArchiveRequest" },
    { "$ref": "#/$defs/projectChatMoveRequest" },
    { "$ref": "#/$defs/settingsGetRequest" },
    { "$ref": "#/$defs/settingsUpdateRequest" },
    { "$ref": "#/$defs/cancelRequest" },
    { "$ref": "#/$defs/permissionResponseRequest" },
    { "$ref": "#/$defs/shutdownRequest" },
    { "$ref": "#/$defs/successResponse" },
    { "$ref": "#/$defs/errorResponse" },
    { "$ref": "#/$defs/streamChunk" },
    { "$ref": "#/$defs/progress" },
    { "$ref": "#/$defs/permission" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "projectIdentifier": {
      "type": "string",
      "minLength": 9,
      "maxLength": 128,
      "pattern": "^project_[A-Za-z0-9_-]+$"
    },
    "protocol": {
      "type": "object",
      "properties": {
        "name": { "const": "elysia.desktop" },
        "version": { "const": 1 }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "requestEnvelope": {
      "type": "object",
      "properties": {
        "type": { "const": "request" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "id": { "$ref": "#/$defs/identifier" },
        "method": {
          "enum": [
            "handshake",
            "initialize",
            "chat.stream",
            "chat.retry",
            "chat.list",
            "chat.create",
            "chat.open",
            "chat.rename",
            "chat.pin",
            "chat.archive",
            "chat.delete",
            "project.list",
            "project.create",
            "project.open",
            "project.update",
            "project.workspace",
            "project.archive",
            "project.chat.move",
            "settings.get",
            "settings.update",
            "request.cancel",
            "permission.respond",
            "shutdown"
          ]
        },
        "params": { "type": "object" }
      },
      "required": ["type", "protocol", "id", "method", "params"],
      "additionalProperties": false
    },
    "handshakeParams": {
      "type": "object",
      "properties": {
        "client": {
          "type": "object",
          "properties": {
            "name": { "$ref": "#/$defs/identifier" },
            "version": { "$ref": "#/$defs/identifier" }
          },
          "required": ["name", "version"],
          "additionalProperties": false
        },
        "sessionToken": {
          "type": "string",
          "minLength": 32,
          "maxLength": 512
        }
      },
      "required": ["client", "sessionToken"],
      "additionalProperties": false
    },
    "initializeParams": {
      "type": "object",
      "maxProperties": 0
    },
    "chatStreamParams": {
      "type": "object",
      "properties": {
        "chatId": { "$ref": "#/$defs/identifier" },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000,
          "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
        }
      },
      "required": ["chatId", "message"],
      "additionalProperties": false
    },
    "chatRetryParams": {
      "type": "object",
      "properties": {
        "chatId": { "$ref": "#/$defs/identifier" },
        "userMessageId": { "$ref": "#/$defs/identifier" },
        "assistantMessageId": { "$ref": "#/$defs/identifier" },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000,
          "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
        }
      },
      "required": ["chatId", "userMessageId", "assistantMessageId"],
      "additionalProperties": false
    },
    "chatListParams": {
      "type": "object",
      "properties": {
        "includeArchived": { "type": "boolean" }
      },
      "required": ["includeArchived"],
      "additionalProperties": false
    },
    "conversationMode": {
      "enum": ["chat", "work"]
    },
    "chatTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000000,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
    },
    "chatCreateParams": {
      "type": "object",
      "properties": {
        "title": { "$ref": "#/$defs/chatTitle" },
        "mode": { "$ref": "#/$defs/conversationMode" }
      },
      "required": ["title", "mode"],
      "additionalProperties": false
    },
    "chatIdParams": {
      "type": "object",
      "properties": {
        "chatId": { "$ref": "#/$defs/identifier" }
      },
      "required": ["chatId"],
      "additionalProperties": false
    },
    "chatRenameParams": {
      "type": "object",
      "properties": {
        "chatId": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/chatTitle" }
      },
      "required": ["chatId", "title"],
      "additionalProperties": false
    },
    "chatPinParams": {
      "type": "object",
      "properties": {
        "chatId": { "$ref": "#/$defs/identifier" },
        "pinned": { "type": "boolean" }
      },
      "required": ["chatId", "pinned"],
      "additionalProperties": false
    },
    "chatArchiveParams": {
      "type": "object",
      "properties": {
        "chatId": { "$ref": "#/$defs/identifier" },
        "archived": { "type": "boolean" }
      },
      "required": ["chatId", "archived"],
      "additionalProperties": false
    },
    "projectName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
    },
    "nullableProjectInstructions": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000,
          "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
        },
        { "type": "null" }
      ]
    },
    "nullableWorkspacePath": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 32767,
          "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
        },
        { "type": "null" }
      ]
    },
    "projectListParams": {
      "type": "object",
      "maxProperties": 0
    },
    "projectCreateParams": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/projectName" },
        "customInstructions": { "$ref": "#/$defs/nullableProjectInstructions" }
      },
      "required": ["name", "customInstructions"],
      "additionalProperties": false
    },
    "projectIdParams": {
      "type": "object",
      "properties": {
        "projectId": { "$ref": "#/$defs/projectIdentifier" }
      },
      "required": ["projectId"],
      "additionalProperties": false
    },
    "projectUpdateParams": {
      "type": "object",
      "properties": {
        "projectId": { "$ref": "#/$defs/projectIdentifier" },
        "name": { "$ref": "#/$defs/projectName" },
        "customInstructions": { "$ref": "#/$defs/nullableProjectInstructions" }
      },
      "required": ["projectId", "name", "customInstructions"],
      "additionalProperties": false
    },
    "projectWorkspaceParams": {
      "type": "object",
      "properties": {
        "projectId": { "$ref": "#/$defs/projectIdentifier" },
        "workspacePath": { "$ref": "#/$defs/nullableWorkspacePath" }
      },
      "required": ["projectId", "workspacePath"],
      "additionalProperties": false
    },
    "projectArchiveParams": {
      "type": "object",
      "properties": {
        "projectId": { "$ref": "#/$defs/projectIdentifier" },
        "archived": { "type": "boolean" }
      },
      "required": ["projectId", "archived"],
      "additionalProperties": false
    },
    "projectChatMoveParams": {
      "type": "object",
      "properties": {
        "chatId": { "$ref": "#/$defs/identifier" },
        "projectId": {
          "oneOf": [
            { "$ref": "#/$defs/projectIdentifier" },
            { "type": "null" }
          ]
        }
      },
      "required": ["chatId", "projectId"],
      "additionalProperties": false
    },
    "settingsValues": {
      "type": "object",
      "properties": {
        "modelName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "allOf": [
            {
              "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]"
            },
            { "pattern": "^[^\\u0000\\r\\n]*$" }
          ]
        },
        "ollamaHost": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https?://(?![^/?#@\\s]*:0(?:/|$))[^/?#@\\s]+/?$"
        },
        "shortTermMemoryTokenBudget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "memoryRetrievalLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "dataImportMaxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "modelName",
        "ollamaHost",
        "shortTermMemoryTokenBudget",
        "memoryRetrievalLimit",
        "dataImportMaxBytes"
      ],
      "additionalProperties": false
    },
    "settingsGetParams": {
      "type": "object",
      "maxProperties": 0
    },
    "settingsUpdateParams": {
      "type": "object",
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "settings": { "$ref": "#/$defs/settingsValues" }
      },
      "required": ["expectedRevision", "settings"],
      "additionalProperties": false
    },
    "cancelParams": {
      "type": "object",
      "properties": {
        "requestId": { "$ref": "#/$defs/identifier" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "required": ["requestId"],
      "additionalProperties": false
    },
    "permissionResponseParams": {
      "type": "object",
      "properties": {
        "permissionId": { "$ref": "#/$defs/identifier" },
        "granted": { "type": "boolean" }
      },
      "required": ["permissionId", "granted"],
      "additionalProperties": false
    },
    "shutdownParams": {
      "type": "object",
      "maxProperties": 0
    },
    "handshakeRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "handshake" },
            "params": { "$ref": "#/$defs/handshakeParams" }
          }
        }
      ]
    },
    "initializeRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "initialize" },
            "params": { "$ref": "#/$defs/initializeParams" }
          }
        }
      ]
    },
    "chatStreamRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "chat.stream" },
            "params": { "$ref": "#/$defs/chatStreamParams" }
          }
        }
      ]
    },
    "chatRetryRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "chat.retry" },
            "params": { "$ref": "#/$defs/chatRetryParams" }
          }
        }
      ]
    },
    "chatListRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "chat.list" },
            "params": { "$ref": "#/$defs/chatListParams" }
          }
        }
      ]
    },
    "chatCreateRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "chat.create" },
            "params": { "$ref": "#/$defs/chatCreateParams" }
          }
        }
      ]
    },
    "chatOpenRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "chat.open" },
            "params": { "$ref": "#/$defs/chatIdParams" }
          }
        }
      ]
    },
    "chatRenameRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "chat.rename" },
            "params": { "$ref": "#/$defs/chatRenameParams" }
          }
        }
      ]
    },
    "chatPinRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "chat.pin" },
            "params": { "$ref": "#/$defs/chatPinParams" }
          }
        }
      ]
    },
    "chatArchiveRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "chat.archive" },
            "params": { "$ref": "#/$defs/chatArchiveParams" }
          }
        }
      ]
    },
    "chatDeleteRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "chat.delete" },
            "params": { "$ref": "#/$defs/chatIdParams" }
          }
        }
      ]
    },
    "projectListRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "project.list" },
            "params": { "$ref": "#/$defs/projectListParams" }
          }
        }
      ]
    },
    "projectCreateRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "project.create" },
            "params": { "$ref": "#/$defs/projectCreateParams" }
          }
        }
      ]
    },
    "projectOpenRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "project.open" },
            "params": { "$ref": "#/$defs/projectIdParams" }
          }
        }
      ]
    },
    "projectUpdateRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "project.update" },
            "params": { "$ref": "#/$defs/projectUpdateParams" }
          }
        }
      ]
    },
    "projectWorkspaceRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "project.workspace" },
            "params": { "$ref": "#/$defs/projectWorkspaceParams" }
          }
        }
      ]
    },
    "projectArchiveRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "project.archive" },
            "params": { "$ref": "#/$defs/projectArchiveParams" }
          }
        }
      ]
    },
    "projectChatMoveRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "project.chat.move" },
            "params": { "$ref": "#/$defs/projectChatMoveParams" }
          }
        }
      ]
    },
    "settingsGetRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "settings.get" },
            "params": { "$ref": "#/$defs/settingsGetParams" }
          }
        }
      ]
    },
    "settingsUpdateRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "settings.update" },
            "params": { "$ref": "#/$defs/settingsUpdateParams" }
          }
        }
      ]
    },
    "cancelRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "request.cancel" },
            "params": { "$ref": "#/$defs/cancelParams" }
          }
        }
      ]
    },
    "permissionResponseRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "permission.respond" },
            "params": { "$ref": "#/$defs/permissionResponseParams" }
          }
        }
      ]
    },
    "shutdownRequest": {
      "allOf": [
        { "$ref": "#/$defs/requestEnvelope" },
        {
          "properties": {
            "method": { "const": "shutdown" },
            "params": { "$ref": "#/$defs/shutdownParams" }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": { "$ref": "#/$defs/identifier" },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "retryable": { "type": "boolean" }
      },
      "required": ["code", "message", "retryable"],
      "additionalProperties": false
    },
    "handshakeResult": {
      "type": "object",
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "server": {
          "type": "object",
          "properties": {
            "name": { "$ref": "#/$defs/identifier" },
            "version": { "$ref": "#/$defs/identifier" }
          },
          "required": ["name", "version"],
          "additionalProperties": false
        },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["protocol", "server", "capabilities"],
      "additionalProperties": false
    },
    "initializeResult": {
      "type": "object",
      "properties": {
        "modelName": { "$ref": "#/$defs/identifier" },
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "minItems": 1,
          "uniqueItems": true
        },
        "chatId": { "$ref": "#/$defs/identifier" },
        "chatTitle": { "type": "string", "minLength": 1, "maxLength": 1000000 }
      },
      "required": ["modelName", "models", "chatId", "chatTitle"],
      "additionalProperties": false
    },
    "chatResult": {
      "type": "object",
      "properties": {
        "chatId": { "$ref": "#/$defs/identifier" },
        "reply": { "type": "string", "minLength": 1, "maxLength": 1000000 }
      },
      "required": ["chatId", "reply"],
      "additionalProperties": false
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "nullableIdentifier": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "chatAttachment": {
      "type": "object",
      "properties": {
        "attachmentId": { "$ref": "#/$defs/identifier" },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 1000000 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 1000000 },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["attachmentId", "fileName", "mediaType", "sizeBytes"],
      "additionalProperties": false
    },
    "chatSessionMessage": {
      "type": "object",
      "properties": {
        "messageId": { "$ref": "#/$defs/identifier" },
        "role": { "enum": ["system", "user", "assistant"] },
        "content": { "type": "string", "maxLength": 1000000 },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "attachments": {
          "type": "array",
          "items": { "$ref": "#/$defs/chatAttachment" }
        }
      },
      "required": ["messageId", "role", "content", "createdAt", "attachments"],
      "additionalProperties": false
    },
    "chatSummaryShape": {
      "type": "object",
      "properties": {
        "chatId": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 1000000 },
        "mode": { "$ref": "#/$defs/conversationMode" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" },
        "messageCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "projectId": { "$ref": "#/$defs/nullableIdentifier" },
        "modelName": { "$ref": "#/$defs/identifier" },
        "pinned": { "type": "boolean" },
        "archived": { "type": "boolean" }
      },
      "required": [
        "chatId", "title", "mode", "createdAt", "updatedAt",
        "messageCount", "projectId", "modelName", "pinned", "archived"
      ]
    },
    "chatSessionSummary": {
      "allOf": [
        { "$ref": "#/$defs/chatSummaryShape" }
      ],
      "unevaluatedProperties": false
    },
    "chatDetail": {
      "allOf": [
        { "$ref": "#/$defs/chatSummaryShape" },
        {
          "type": "object",
          "properties": {
            "messages": {
              "type": "array",
              "items": { "$ref": "#/$defs/chatSessionMessage" },
              "uniqueItems": true
            }
          },
          "required": ["messages"]
        }
      ],
      "unevaluatedProperties": false
    },
    "chatStateResult": {
      "type": "object",
      "properties": {
        "activeChat": { "$ref": "#/$defs/chatDetail" },
        "chats": {
          "type": "array",
          "items": { "$ref": "#/$defs/chatSessionSummary" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["activeChat", "chats"],
      "additionalProperties": false
    },
    "projectSummary": {
      "type": "object",
      "properties": {
        "projectId": { "$ref": "#/$defs/projectIdentifier" },
        "name": { "$ref": "#/$defs/projectName" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" },
        "customInstructions": { "$ref": "#/$defs/nullableProjectInstructions" },
        "workspacePath": { "$ref": "#/$defs/nullableWorkspacePath" },
        "archived": { "type": "boolean" },
        "chatCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "projectId", "name", "createdAt", "updatedAt",
        "customInstructions", "workspacePath", "archived", "chatCount"
      ],
      "additionalProperties": false
    },
    "projectStateResult": {
      "type": "object",
      "properties": {
        "activeProject": {
          "oneOf": [
            { "$ref": "#/$defs/projectSummary" },
            { "type": "null" }
          ]
        },
        "projects": {
          "type": "array",
          "items": { "$ref": "#/$defs/projectSummary" },
          "uniqueItems": true
        },
        "chatState": { "$ref": "#/$defs/chatStateResult" }
      },
      "required": ["activeProject", "projects", "chatState"],
      "additionalProperties": false
    },
    "settingsProjectScope": {
      "type": "object",
      "properties": {
        "projectId": { "$ref": "#/$defs/projectIdentifier" },
        "projectName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "modelName": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 200 },
            { "type": "null" }
          ]
        },
        "inheritedModelName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "projectId", "projectName", "modelName", "inheritedModelName"
      ],
      "additionalProperties": false
    },
    "settingsChatScope": {
      "type": "object",
      "properties": {
        "chatId": { "$ref": "#/$defs/identifier" },
        "chatTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "modelName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": ["chatId", "chatTitle", "modelName"],
      "additionalProperties": false
    },
    "settingsScopes": {
      "type": "object",
      "properties": {
        "project": {
          "oneOf": [
            { "$ref": "#/$defs/settingsProjectScope" },
            { "type": "null" }
          ]
        },
        "chat": {
          "oneOf": [
            { "$ref": "#/$defs/settingsChatScope" },
            { "type": "null" }
          ]
        }
      },
      "required": ["project", "chat"],
      "additionalProperties": false
    },
    "settingsStateResult": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updatedAt": {
          "oneOf": [
            { "$ref": "#/$defs/timestamp" },
            { "type": "null" }
          ]
        },
        "settings": { "$ref": "#/$defs/settingsValues" },
        "activeSettings": { "$ref": "#/$defs/settingsValues" },
        "restartRequired": { "type": "boolean" },
        "restartFields": {
          "type": "array",
          "items": {
            "enum": [
              "modelName",
              "ollamaHost",
              "shortTermMemoryTokenBudget",
              "memoryRetrievalLimit",
              "dataImportMaxBytes"
            ]
          },
          "maxItems": 5,
          "uniqueItems": true
        },
        "scopes": { "$ref": "#/$defs/settingsScopes" },
        "warning": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 1000 },
            { "type": "null" }
          ]
        }
      },
      "required": [
        "revision",
        "updatedAt",
        "settings",
        "activeSettings",
        "restartRequired",
        "restartFields",
        "scopes",
        "warning"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "restartRequired": { "const": true } },
            "required": ["restartRequired"]
          },
          "then": {
            "properties": { "restartFields": { "minItems": 1 } }
          },
          "else": {
            "properties": { "restartFields": { "maxItems": 0 } }
          }
        }
      ]
    },
    "shutdownResult": {
      "type": "object",
      "properties": { "stopped": { "const": true } },
      "required": ["stopped"],
      "additionalProperties": false
    },
    "successResponse": {
      "type": "object",
      "properties": {
        "type": { "const": "response" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "id": { "$ref": "#/$defs/identifier" },
        "ok": { "const": true },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/handshakeResult" },
            { "$ref": "#/$defs/initializeResult" },
            { "$ref": "#/$defs/chatResult" },
            { "$ref": "#/$defs/chatStateResult" },
            { "$ref": "#/$defs/projectStateResult" },
            { "$ref": "#/$defs/settingsStateResult" },
            { "$ref": "#/$defs/shutdownResult" }
          ]
        }
      },
      "required": ["type", "protocol", "id", "ok", "result"],
      "additionalProperties": false
    },
    "errorResponse": {
      "type": "object",
      "properties": {
        "type": { "const": "response" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "id": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "ok": { "const": false },
        "error": { "$ref": "#/$defs/error" }
      },
      "required": ["type", "protocol", "id", "ok", "error"],
      "additionalProperties": false
    },
    "streamChunk": {
      "type": "object",
      "properties": {
        "type": { "const": "stream" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "requestId": { "$ref": "#/$defs/identifier" },
        "stream": { "const": "chat.reply" },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "chunk": { "type": "string", "maxLength": 1000000 },
        "done": { "type": "boolean" }
      },
      "required": [
        "type", "protocol", "requestId", "stream", "sequence", "chunk", "done"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "done": { "const": true } },
            "required": ["done"]
          },
          "then": {
            "properties": { "chunk": { "const": "" } }
          }
        }
      ]
    },
    "progress": {
      "type": "object",
      "properties": {
        "type": { "const": "progress" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "requestId": { "$ref": "#/$defs/identifier" },
        "operation": { "$ref": "#/$defs/identifier" },
        "completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            { "type": "null" }
          ]
        },
        "message": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 1000000 },
            { "type": "null" }
          ]
        }
      },
      "required": [
        "type", "protocol", "requestId", "operation", "completed", "total", "message"
      ],
      "additionalProperties": false
    },
    "permission": {
      "type": "object",
      "properties": {
        "type": { "const": "permission" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "requestId": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "permissionId": { "$ref": "#/$defs/identifier" },
        "capability": { "$ref": "#/$defs/identifier" },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "scopes": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      },
      "required": [
        "type", "protocol", "requestId", "permissionId", "capability", "reason", "scopes"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "type": { "const": "event" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "event": { "$ref": "#/$defs/identifier" },
        "requestId": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "data": { "type": "object" }
      },
      "required": ["type", "protocol", "event", "requestId", "data"],
      "additionalProperties": false
    }
  }
}
